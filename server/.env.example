# MAMOR-AI server（AIゲートウェイ＋未報告コールのワーカー）
# ここに書く鍵はサーバだけに置く。フロント（VITE_*）へは絶対に入れない。

PORT=3001
CORS_ORIGIN=http://localhost:5173

# ── 未報告コール（起床・出発・上番・下番）──────────────
# 外部スケジューラが POST /api/jobs/jyoban-calls を呼ぶときの合言葉（Authorization: Bearer <値>）
CRON_SECRET=
# Supabase（service_role。RLSを越えるのでサーバ以外に置かない）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 通知タップで開くURL
JYOBAN_APP_URL=https://example.com/app/

# メール（Resend）
RESEND_API_KEY=
JYOBAN_MAIL_FROM=MAMOR-AI <noreply@example.co.jp>

# SMS・自動音声電話（Twilio）
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# 日本向けSMSは Messaging Service（英数字送信者ID）推奨。設定すると TWILIO_FROM より優先
TWILIO_MESSAGING_SERVICE_SID=
# 電話の発信元（未設定なら TWILIO_FROM）
TWILIO_VOICE_FROM=

# アプリ通知（Web Push / VAPID）。npx web-push generate-vapid-keys で作成
# 公開鍵は apps/desktop の VITE_VAPID_PUBLIC_KEY にも同じ値を入れる
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.co.jp
